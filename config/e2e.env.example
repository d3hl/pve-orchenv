# Build profile for the nested e2e test site. Copy to config/e2e.env (gitignored).
BOOTSERVER_HOST=10.203.1.208
BOOTSERVER_HTTP_PORT=8080
ANSWER_URL=http://$BOOTSERVER_HOST:8080/answer
# Empty = boot server runs on this workstation.
BOOTSERVER_SSH=

# E2E (nested PVE on a hypervisor; test VMs are untagged on 10.203.1.0/24)
E2E_PVE_API_URL=https://10.203.1.113:8006
E2E_PVE_TOKEN_ID=
E2E_NODE=pve
E2E_STORAGE=local-zfs
E2E_BRIDGE=vmbr0
# SSH target of E2E_NODE, used for console screendumps
E2E_HYPERVISOR_SSH=
