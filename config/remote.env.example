# Build profile for the remote site (10.10.10.0/24, reached over IPsec). Copy to config/remote.env (gitignored).
# BOOTSERVER_HOST is a placeholder: operator to confirm.
# The boot server runs AT the remote site, never on a PVE node it provisions.
BOOTSERVER_HOST=10.10.10.5
BOOTSERVER_HTTP_PORT=8080
ANSWER_URL=http://$BOOTSERVER_HOST:8080/answer
BOOTSERVER_SSH=root@10.10.10.5
# Inventory the answer service loads for this site (only its own; colon-separated, repo-relative)
INVENTORY_FILES=inventory/hosts.yml
