FROM debian:trixie
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
 && curl -fsSL https://enterprise.proxmox.com/debian/proxmox-archive-keyring-trixie.gpg \
      -o /usr/share/keyrings/proxmox-archive-keyring.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/proxmox-archive-keyring.gpg] http://download.proxmox.com/debian/pve trixie pve-no-subscription" \
      > /etc/apt/sources.list.d/pve-no-subscription.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends proxmox-auto-install-assistant xorriso cpio zstd gzip git make gcc libc6-dev binutils liblzma-dev perl gettext-base \
 && rm -rf /var/lib/apt/lists/*
